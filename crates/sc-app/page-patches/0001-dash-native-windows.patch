+    /** The app's displays come with their names (the monitor's own name), so the picker is the same. */
+    async function detachInApp(tab) {
+      const { displays, shared } = await APP.request('displays');
+      if (!displays.length) { notice('The app sees no displays', 'bad'); return; }
+      const labels = displays.map((d) => d.label);
+      const wanted = tab.placement ? labels.indexOf(tab.placement.displayLabel) : -1;
+      const pick = wanted >= 0 ? wanted : Math.max(0, displays.findIndex((d) => !d.primary));
+      const text = (d) => `${d.width} x ${d.height} at ${d.left}, ${d.top}${d.primary ? ', primary' : ''}${d.builtin ? ', built in' : ''}`;
+      const list = displays.map((d, i) => `<label class="screen"><input type="radio" name="scr" value="${i}" ${i === pick ? 'checked' : ''} />` +
+        `<b>${esc(d.label || 'Unnamed display')}</b><small>${esc(text(d))}</small></label>`).join('');
+      const body = `<p>Choose the display for ${esc(tab.name)}. It opens in use mode, with the cursor hidden, and never takes the focus from the game.</p><div class="screens">${list}</div>` +
+        `<label class="check"><input type="checkbox" id="d-fs" ${!tab.placement || tab.placement.fullscreen ? 'checked' : ''} /> Full screen</label>` +
+        `<label class="check"><input type="checkbox" id="d-keep" checked /> Remember this display for the tab</label>` +
+        (tab.placement && wanted < 0 ? `<p class="warn">The remembered display, ${esc(tab.placement.displayLabel)}, is not connected.</p>` : '');
+      const c = await ask(`Detach ${tab.name}`, body, [{ text: 'Cancel', value: 'cancel' }, { text: 'Open on display', value: 'open', cls: 'primary' }]);
+      if (c !== 'open') return;
+      const d = displays[Number(($('dlg-body').querySelector('input[name=scr]:checked') || {}).value || 0)];
+      const fs = $('d-fs').checked;
+      const label = (d.label || '').trim();
+      if (!label) { notice('This display has no name, so the app cannot place a window on it by name', 'bad'); return; }
+      if (shared.includes(d.label)) { notice(`Two displays are named ${label}, so the app cannot tell them apart`, 'bad'); return; }
+      const r = await APP.request('open', { tab: tab.id, displayLabel: d.label, fullscreen: fs });
+      if (!r.ok) { notice(r.text, 'bad'); return; }
+      if ($('d-keep').checked) send({ type: 'dash.setPlacement', tab: tab.id, placement: { displayLabel: label.slice(0, meta.limits.displayLabel), fullscreen: fs } });
+    }
